# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/smart_canteen?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Server Port (Render automatically supplies PORT)
SERVER_PORT=8080
PORT=8080

# Allowed college email domain (optional)
COLLEGE_EMAIL_DOMAIN=

# Frontend Origin for CORS (e.g., your Vercel URL in production: https://smart-canteen.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173

# Cookie Security Settings (In production with cross-origin Vercel + Render: COOKIE_SAME_SITE=none, COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
